# Copy this file to `.env` and adjust for your environment. Do NOT commit a real `.env` (SEC-008).
# All VITE_* values are bundled into the client build, so keep genuine secrets out of here entirely.

# Keycloak OIDC (Auth Code + PKCE). Use https:// origins outside local dev.
VITE_KEYCLOAK_URL=http://localhost:8081
VITE_KEYCLOAK_REALM=carddemo
VITE_KEYCLOAK_CLIENT_ID=mg01-frontend

# Realm role / token scope that authorizes writes — client-side gating only (SEC-006); the
# backend enforces it authoritatively regardless of which form Keycloak surfaces it as.
VITE_ADMIN_REALM_ROLE=txn_type_admin
VITE_ADMIN_AUTHORITY=TXN_TYPE_ADMIN

# API base path (reached through the Vite dev proxy -> the transaction-type-service).
VITE_API_BASE=/api/v1

# SEC-007: origins the production Content-Security-Policy allows the app to call. The policy is
# generated at build time from VITE_KEYCLOAK_URL plus VITE_API_ORIGIN — set VITE_API_ORIGIN only
# when the API is served from a different origin than the SPA (leave empty when it is same-origin
# behind a reverse proxy). Dev builds add the localhost/HMR origins automatically.
VITE_API_ORIGIN=

# Admin-area route used for the Back / Exit affordance (G7 — single swap point).
VITE_ADMIN_ROUTE=/transaction-types
